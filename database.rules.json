{
  "rules": {
    ".read": false,
    ".write": false,
    "app_version": {
      ".read": "auth != null",
      ".write": "auth != null",
      "current": { ".validate": "newData.isString() && newData.val().length < 20" }
    },
    "state": {
      ".read": "auth != null",
      ".write": "auth != null",
      "shared": {
        "v2": {
          "meta": {
            "timestamp": { ".validate": "newData.isNumber()" },
            "deviceId":  { ".validate": "newData.isString() && newData.val().length < 80" }
          },
          "coll": {
            "$name": {
              "j": { ".validate": "newData.isString() && newData.val().length < 12000000" },
              "h": { ".validate": "newData.isString() && newData.val().length < 16" },
              "t": { ".validate": "newData.isNumber()" }
            }
          }
        }
      }
    }
  }
}
